[Unit]
Description=Centropic analyze worker (dedicated host, no local web)
Documentation=file:///opt/aio-bot/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aio-bot
Group=aio-bot
WorkingDirectory=/opt/aio-bot
EnvironmentFile=/opt/aio-bot/.env
Environment=ANALYZE_WORKER_CONCURRENCY=8
Environment=ANALYZE_WORKER_IDLE_SLEEP=2
# Same REDIS_URL + DATABASE_URL as the web host. Claim stays exclusive via Postgres.
ExecStart=/opt/aio-bot/.venv/bin/python /opt/aio-bot/scripts/analyze_worker.py --loop
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
