[Unit]
Description=Centropic analyze queue safety-net (fallback if loop worker is down)
# Prefer the long-running aio-bot-analyze.service (--loop). This timer is a
# backup oneshot so pending jobs still drain if the loop unit is stopped.

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true
Unit=aio-bot-analyze-oneshot.service

[Install]
WantedBy=timers.target
