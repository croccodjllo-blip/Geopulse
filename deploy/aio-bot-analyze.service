[Unit]
Description=GeoPulse async analyze job worker
After=network.target aio-bot.service

[Service]
Type=oneshot
User=aio-bot
Group=aio-bot
WorkingDirectory=/opt/aio-bot
EnvironmentFile=/opt/aio-bot/.env
ExecStart=/opt/aio-bot/.venv/bin/python /opt/aio-bot/scripts/analyze_worker.py --limit 5
Nice=10
