[Unit]
Description=Centropic analyze worker instance %i
Documentation=file:///opt/aio-bot/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Dedicated worker hosts: do not require local aio-bot (web) service.

[Service]
Type=simple
User=aio-bot
Group=aio-bot
WorkingDirectory=/opt/aio-bot
EnvironmentFile=-/opt/aio-bot/.env
EnvironmentFile=-/opt/aio-bot/deploy/analyze-worker-%i.env
Environment=ANALYZE_WORKER_CONCURRENCY=4
Environment=ANALYZE_WORKER_IDLE_SLEEP=2
ExecStart=/opt/aio-bot/.venv/bin/python /opt/aio-bot/scripts/analyze_worker.py --loop
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
