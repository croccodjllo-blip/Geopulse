FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Claude (Anthropic) — SoV measured / citation monitor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Alias opzionale: CLAUDE_API_KEY= / CLAUDE_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
DATABASE_URL=sqlite:////data/database.db
HOST_PORT=8000
HTTP_PORT=80
SESSION_COOKIE_SECURE=1
PREFERRED_URL_SCHEME=https
PUBLIC_SITE_URL=https://centropic.ai
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
ADSENSE_CLIENT_ID=
# Optional full ads.txt content (multi-line via \n). If empty and ADSENSE_CLIENT_ID is set,
# the app serves: google.com, <ADSENSE_CLIENT_ID>, DIRECT, f08c47fec0942fa0
ADS_TXT_CONTENT=
# Google Ads (optional conversions linked to GA4)
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_ANALYZE_LABEL=
GOOGLE_ADS_TOPUP_LABEL=

# Edge Signals: CORS (vuoto=nessuno; * o origin esatto). Rate limit /e/<token>
EDGE_CORS_ORIGIN=
EDGE_RATE_LIMIT=120
EDGE_RATE_WINDOW=60
# Rate limiter condiviso tra worker Gunicorn
RATE_LIMIT_DB=
# 1 = consente DROP+recreate di analysis_jobs su schema legacy
ALLOW_DROP_ANALYSIS_JOBS=0
ADMIN_EMAIL=admin@centropic.ai
# Obbligatoria per creare l’admin al boot. Nessun default in chiaro.
ADMIN_PASSWORD=
# Metti 1 solo quando vuoi forzare il reset password admin al restart.
ADMIN_BOOTSTRAP=0
ADMIN_NAME=Admin GeoPulse
SITE_AUTHOR_NAME=Engineering Factory
SITE_AUTHOR_TITLE=Proprietario · Responsabile contenuti e prodotto
SITE_AUTHOR_URL=https://www.engineeringfactory.app/
SITE_OWNER_NAME=Engineering Factory
SITE_OWNER_URL=https://www.engineeringfactory.app/
PRO_DAILY_ANALYSES=200
MAX_SITES_PRO=50
# Free: 1 sito + 2 analisi lifetime (nessun reset 24h)
MAX_SITES_FREE=1
FREE_TOTAL_ANALYSES=2
FREE_CRAWL_PAGES=8
# Plus: 0 = crawl intero sito (tetto operativo ABS_MAX_CRAWL_PAGES=2000)
PRO_CRAWL_PAGES=0
FREE_HISTORY_LIMIT=10
PRO_HISTORY_LIMIT=100
RESCAN_BATCH_LIMIT=20
ANALYZE_BATCH_LIMIT=5
# 1 = analisi in coda (dashboard non blocca); worker systemd o kick thread
ASYNC_ANALYZE=1
# Dettaglio /health?token=... (opzionale). Senza token: solo ok/service/time.
HEALTH_DETAIL_TOKEN=
# Plus only: probe LLM per SoV measured (OPENAI / PERPLEXITY / ANTHROPIC)
MEASURED_SOV_ON_ANALYZE=1
# Credito di benvenuto alla registrazione (centesimi EUR). Default €2.00
WELCOME_CREDIT_CENTS=200
# Margine di sicurezza sul saldo richiesto prima di avviare un'analisi (0.08 = 8%)
CREDIT_GRACE_MARGIN=0.08
PASSWORD_RESET_HOURS=2
PACK_EMAIL_DAILY_LIMIT=10
# Stripe Billing (Plus). Se mancano, prezzi mostra waitlist.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook dedicato per ricariche credito one-shot (Checkout payment mode)
STRIPE_TOPUP_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
# Email pack (scegli Resend oppure SMTP)
RESEND_API_KEY=
MAIL_FROM=GeoPulse <noreply@geopulse.it>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0

# Cursor API (opzionale)
CURSOR_API_KEY=
