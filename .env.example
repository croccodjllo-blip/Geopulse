FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Claude (Anthropic) — SoV measured / citation monitor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Alias opzionale: CLAUDE_API_KEY= / CLAUDE_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# Google AI (Gemini) — SoV measured / AI Overview probe
# Create at https://aistudio.google.com/apikey (do not commit real keys)
GEMINI_API_KEY=
# Prefer alias models (gemini-flash-latest) — fixed IDs like gemini-2.0-flash
# often return 429 quota=0 for new AQ. auth keys on free tier.
GEMINI_MODEL=gemini-flash-latest
# Alias opzionale: GOOGLE_AI_API_KEY= / GOOGLE_API_KEY=
# xAI Grok — SoV measured probe (https://console.x.ai → API Keys)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
# Alias opzionale: GROK_API_KEY= / GROK_MODEL=
# Microsoft Copilot-like SoV via Azure AI Foundry (AIProjectClient)
# Endpoint = Project endpoint from Foundry (includes /api/projects/<name>).
# SDK v2 does NOT take project_name separately — it is part of the endpoint URL.
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
# FOUNDRY_PROJECT_ENDPOINT=   # alias
AZURE_AI_PROJECT_ENDPOINT=
# API key from Foundry / Azure AI resource (Keys and Endpoint) — simplest on VPS
AZURE_AI_API_KEY=
AZURE_AI_MODEL=gpt-4o-mini
# Optional Agent with Grounding with Bing Search (recommended for Copilot-like answers)
AZURE_AI_AGENT_NAME=
# Entra ID service principal (alternative to API key)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# AZURE_AI_USE_DEFAULT_CREDENTIAL=0
DATABASE_URL=sqlite:////data/database.db
# Produzione multi-worker: Postgres obbligatorio (SQLite forza WEB_CONCURRENCY=1 nel container).
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/centropic
# WEB_CONCURRENCY=2
# WEB_THREADS=4

# Job worker lease (reclaim running jobs with silent heartbeat; floor 2 min)
# JOB_STALE_HEARTBEAT_MINUTES=5
# JOB_MAX_ATTEMPTS=2
HOST_PORT=8000
# App listens on 127.0.0.1:HOST_PORT (docker-compose). Nginx proxies to it.
# TRUST_PROXY=1 enables ProxyFix for X-Forwarded-For/Proto (default on).
# Required with TRUST_PROXY=1: traffic must only reach the app via Nginx.
BEHIND_NGINX=1
TRUST_PROXY=1
HTTP_PORT=80
SESSION_COOKIE_SECURE=1
PREFERRED_URL_SCHEME=https
PUBLIC_SITE_URL=https://centropic.ai
GA4_MEASUREMENT_ID=
# Meta-tag token (optional). HTML-file proof is also served at:
#   /googlee1d69b8c33683acd.html
GOOGLE_SITE_VERIFICATION=
ADSENSE_CLIENT_ID=
# Optional full ads.txt content (multi-line via \n). If empty and ADSENSE_CLIENT_ID is set,
# the app serves: google.com, <ADSENSE_CLIENT_ID>, DIRECT, f08c47fec0942fa0
ADS_TXT_CONTENT=
# Google Ads (optional conversions linked to GA4)
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_ANALYZE_LABEL=
GOOGLE_ADS_TOPUP_LABEL=

# Edge Signals: CORS (vuoto=nessuno; * o origin esatto). Rate limit /e/<token>
EDGE_CORS_ORIGIN=
EDGE_RATE_LIMIT=120
EDGE_RATE_WINDOW=60
# Rate limiter condiviso tra worker Gunicorn
RATE_LIMIT_DB=
# Solo dev/test: consente fallback in-memory se RATE_LIMIT_DB non è scrivibile
# ALLOW_MEMORY_RATE_LIMITER=0
# 1 = consente DROP+recreate di analysis_jobs su schema legacy (MAI in produzione)
ALLOW_DROP_ANALYSIS_JOBS=0
ADMIN_EMAIL=admin@centropic.ai
# Auto-translate UI catalogs (scripts/i18n_auto_translate.py)
# I18N_MODEL=gpt-4o-mini
# Obbligatoria per creare l’admin al boot. Nessun default in chiaro.
ADMIN_PASSWORD=
# Metti 1 solo quando vuoi forzare il reset password admin al restart.
ADMIN_BOOTSTRAP=0
ADMIN_NAME=Admin Centropic
SITE_AUTHOR_NAME=Engineering Factory
SITE_AUTHOR_TITLE=Proprietario · Responsabile contenuti e prodotto
SITE_AUTHOR_URL=https://www.engineeringfactory.app/
SITE_OWNER_NAME=Engineering Factory
SITE_OWNER_URL=https://www.engineeringfactory.app/
PRO_DAILY_ANALYSES=200
MAX_SITES_PRO=50
# Free: 1 sito + 2 analisi lifetime (nessun reset 24h)
MAX_SITES_FREE=1
FREE_TOTAL_ANALYSES=2
FREE_CRAWL_PAGES=8
# Plus: 0 = crawl intero sito (tetto operativo ABS_MAX_CRAWL_PAGES=2000)
PRO_CRAWL_PAGES=120
# Deep crawl opt-in (dashboard checkbox). Caps at ABS_MAX_CRAWL_PAGES (2000).
PRO_DEEP_CRAWL_PAGES=500
# SoV measured: parallel engines (1-6) and prompt mode full|fast
SOV_ENGINE_PARALLEL=3
SOV_PROMPT_MODE=full
SOV_FAST_PROMPTS=3
# Limite giornaliero addebiti SoV/citation in centesimi (default codice 5000 = €50). 0 = illimitato
SOV_DAILY_BUDGET_CENTS=5000
FREE_HISTORY_LIMIT=10
PRO_HISTORY_LIMIT=100
RESCAN_BATCH_LIMIT=20
ANALYZE_BATCH_LIMIT=5
# 1 = analisi in coda (dashboard non blocca); worker systemd o kick thread
ASYNC_ANALYZE=1
# /health hard-fails on Fase 0 env violations when FLASK_DEBUG=0 (default).
# Requires DATABASE_URL set (no silent local SQLite fallback in prod health).
# HEALTH_REQUIRE_PROD_GUARDS=1
# CENTROPIC_SKIP_PROD_GUARDS=1
# Optional: 503 /health when stale running analyze jobs detected.
# HEALTH_FAIL_ON_STALE_JOBS=0
# Dettaglio /health?token=... (opzionale). Senza token: solo ok/service/time + degraded.
HEALTH_DETAIL_TOKEN=
# Plus only: probe LLM per SoV measured (OPENAI / PERPLEXITY / ANTHROPIC / GEMINI)
MEASURED_SOV_ON_ANALYZE=1
# Optional Playwright JS render for thin SPA seed pages (requires: pip install playwright && playwright install chromium)
JS_CRAWL_ENABLED=0
# Credito di benvenuto alla registrazione (centesimi EUR). Default €2.00
WELCOME_CREDIT_CENTS=200
# Margine di sicurezza sul saldo richiesto prima di avviare un'analisi (0.08 = 8%)
CREDIT_GRACE_MARGIN=0.08
PASSWORD_RESET_HOURS=2
PACK_EMAIL_DAILY_LIMIT=10

# Paddle Billing (merchant of record — only payment provider)
# Produzione: PADDLE_ENV=production + token/chiavi live
# Sandbox solo con PUBLIC_SITE_URL non-prod, oppure ALLOW_PADDLE_SANDBOX_ON_PROD=1
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Secret from Paddle → Developer Tools → Notifications → endpoint secret
# (usually starts with pdl_ntfsec_). Comma-separate to accept rotation.
# Webhook URL: https://centropic.ai/billing/paddle-webhook
# Eventi: subscription.*, transaction.completed, transaction.paid
PADDLE_PRICE_PLUS_MONTHLY=
# Business (agenzie) — €49.99/mo, 400 token/mese, API + white-label
PADDLE_PRICE_BUSINESS_MONTHLY=
# Optional yearly catalog prices
# PADDLE_PRICE_PLUS_YEARLY=
# PADDLE_PRICE_BUSINESS_YEARLY=
# Pacchetti credito (price ID catalogo Paddle, one-time)
# Top-up packs: €10=100 token, €20=200, €50=600 (1 token = €0.10)
# Plus monthly (€14.99) includes 100 token; Business (€49.99) includes 400 token
MAX_SITES_PLUS=5
# MAX_SITES_PRO = Business site cap (default 50)
PADDLE_PRICE_TOPUP_1000=
PADDLE_PRICE_TOPUP_2000=
PADDLE_PRICE_TOPUP_5000=
# Webhook URL da registrare in Paddle → Notifications:
#   https://centropic.ai/billing/paddle-webhook
# Eventi: subscription.*, transaction.completed, transaction.paid

# Email pack (scegli Resend oppure SMTP)
RESEND_API_KEY=
MAIL_FROM=Centropic <noreply@centropic.ai>
# When using SMTP (e.g. Aruba), MAIL_FROM address must match SMTP_USER mailbox
# or the app rewrites From to SMTP_USER automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0

# Optional pacing between measured SoV prompts (milliseconds)
LLM_PROBE_PACING_MS=250

# Cursor API (opzionale)
CURSOR_API_KEY=
